generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceMemberRole {
  owner
  admin
  member
}

enum LeadStatus {
  new
  qualified
  unqualified
  scheduled
  handed_off
  won
  lost
}

enum CallStatus {
  ringing
  in_progress
  completed
  failed
  no_answer
}

enum CallOutcome {
  unknown
  qualified
  scheduled
  handoff
  not_qualified
  follow_up
  sold
  booked_meeting
  booked_google_meet
  followup_scheduled
  info_collected
  transferred
  not_interested
  disqualified
}

enum CallObjective {
  sell_product
  book_in_person_meeting
  book_google_meet
  book_calcom_appointment
  schedule_followup_call
  collect_lead_info
  qualify_only
  transfer_to_human
  send_summary
}

enum AgentLanguage {
  en
  es
}

enum MeetingType {
  in_person
  google_meet
  phone_call
}

enum CalendarProvider {
  calcom
  google
  manual
}

enum BridgeLeadObjective {
  CLOSE_SALE
  BOOK_MEET
  BOOK_IN_PERSON
  SCHEDULE_FOLLOWUP
}

enum BridgeLeadStatus {
  new
  queued
  calling
  completed
  failed
}

enum BridgeLeadOutcome {
  unknown
  sold
  booked
  followup
  not_interested
  disqualified
}

enum LeadHandoffStatus {
  queued
  calling
  completed
  failed
}

enum TranscriptSpeaker {
  user
  assistant
  system
}

enum HandoffReason {
  uncertainty
  objection
  high_intent
  requested_human
  technical
}

enum HandoffStatus {
  requested
  completed
  failed
}

enum UserAccessStatus {
  active
  deactivated
  temporarily_disabled
  blocked
}

model User {
  id                String            @id @default(cuid())
  name              String?
  email             String            @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  accessStatus      UserAccessStatus  @default(active)
  accessReason      String?
  accessDisabledUntil DateTime?
  accessUpdatedAt   DateTime          @default(now())
  activeWorkspaceId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  accounts      Account[]
  sessions      Session[]
  passwordResetTokens PasswordResetToken[]
  memberships   WorkspaceMember[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  activeWorkspace Workspace?        @relation("ActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
}

model Workspace {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  ownerId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner         User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  activeUsers   User[]            @relation("ActiveWorkspace")
  members       WorkspaceMember[]
  twilioNumbers TwilioPhoneNumber[]
  agentConfig   AgentConfig?
  leads         Lead[]
  calls         Call[]
  transcripts   TranscriptTurn[]
  appointments  Appointment[]
  handoffs      Handoff[]
  metricsDaily  MetricDaily[]
  callPreferences AgentCallPreferences?
  businessProfile BusinessProfile?
  bridgeCustomers Customer[]
  bridgeLeads     BridgeLead[]
  callLogs        CallLog[]
  leadHandoffs    LeadHandoff[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole @default(member)
  createdAt   DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model TwilioPhoneNumber {
  id          String   @id @default(cuid())
  workspaceId String
  phoneNumber String   @unique
  friendlyName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
}

model AgentConfig {
  id                     String   @id @default(cuid())
  workspaceId            String   @unique
  agentName              String   @default("AI Call Closer")
  systemPrompt           String   @db.Text
  greetingMessage        String
  qualificationChecklist Json
  pricingRules           Json
  disallowedClaims       Json
  handoffEnabled         Boolean  @default(true)
  handoffPhone           String?
  calendarLink           String?
  voiceModel             String   @default("gpt-4o-mini-tts")
  ttsVoice               String   @default("alloy")
  sttModel               String   @default("gpt-4o-mini-transcribe")
  llmModel               String   @default("gpt-4.1-mini")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bridgeLeads BridgeLead[]
  leadHandoffs LeadHandoff[]
}

model Lead {
  id         String     @id @default(cuid())
  workspaceId String
  fullName   String?
  email      String?
  phone      String?
  company    String?
  notes      String?
  customFields Json?
  score      Int        @default(0)
  status     LeadStatus @default(new)
  source     String     @default("inbound_call")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  calls        Call[]
  appointments Appointment[]
  handoffs     Handoff[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, phone])
  @@unique([workspaceId, phone])
}

model Customer {
  id           String   @id @default(cuid())
  workspaceId  String
  customerName String
  customerId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     BridgeLead[]

  @@unique([workspaceId, customerName])
  @@unique([workspaceId, customerId])
  @@index([workspaceId, createdAt])
}

model BridgeLead {
  id            String             @id @default(cuid())
  workspaceId   String
  customerId    String
  agentId       String
  externalId    String
  clientName    String?
  phoneE164     String
  objective     BridgeLeadObjective
  collectedInfo Json
  preferredTimes Json
  status        BridgeLeadStatus   @default(new)
  lastCallSid   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agent     AgentConfig @relation(fields: [agentId], references: [id], onDelete: Restrict)
  callLogs  CallLog[]

  @@unique([customerId, externalId])
  @@index([workspaceId, status])
  @@index([workspaceId, phoneE164])
}

model CallLog {
  id         String           @id @default(cuid())
  workspaceId String
  leadId      String
  callSid     String?
  outcome     BridgeLeadOutcome @default(unknown)
  transcript  String?          @db.Text
  summary     String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      BridgeLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([leadId, createdAt])
  @@index([callSid])
}

model LeadHandoff {
  id                 String           @id @default(cuid())
  workspaceId        String
  agentId            String
  sourceProduct      String
  widgetId           String
  clientId           String
  leadChatSlug       String
  sentAt             DateTime
  leadName           String
  leadPhone          String
  leadPhoneE164      String
  leadCollectedInfo  String           @db.Text
  consentAccepted    Boolean          @default(true)
  consentAcceptedAt  DateTime
  consentTextVersion String
  consentText        String           @db.Text
  consentIp          String
  consentUserAgent   String
  history            Json
  payload            Json
  receivedAt         DateTime         @default(now())
  status             LeadHandoffStatus @default(queued)
  lastCallSid        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     AgentConfig @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
  @@index([workspaceId, receivedAt])
  @@index([lastCallSid])
}

model Call {
  id             String      @id @default(cuid())
  workspaceId    String
  leadId         String?
  twilioCallSid  String      @unique
  fromNumber     String
  toNumber       String
  status         CallStatus  @default(ringing)
  outcome        CallOutcome @default(unknown)
  durationSeconds Int?
  summary        String?
  objectiveApplied CallObjective?
  startedAt      DateTime    @default(now())
  endedAt        DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  transcripts TranscriptTurn[]
  appointment Appointment?
  handoff     Handoff?

  @@index([workspaceId, startedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, outcome])
}

model TranscriptTurn {
  id          String            @id @default(cuid())
  workspaceId String
  callId      String
  speaker     TranscriptSpeaker
  text        String            @db.Text
  metadata    Json?
  spokenAt    DateTime          @default(now())
  createdAt   DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  call      Call      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([workspaceId, spokenAt])
  @@index([callId, spokenAt])
}

model Appointment {
  id          String   @id @default(cuid())
  workspaceId String
  leadId      String
  callId      String?  @unique
  startsAt    DateTime
  timezone    String   @default("America/New_York")
  meetingType MeetingType @default(phone_call)
  calendarProvider CalendarProvider @default(manual)
  meetingUrl  String?
  locationText String?
  bookingIntent Json?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  call      Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startsAt])
  @@index([leadId, startsAt])
}

model AgentCallPreferences {
  id                    String           @id @default(cuid())
  workspaceId           String           @unique
  primaryObjective      CallObjective    @default(qualify_only)
  secondaryObjectives   CallObjective[]
  language              AgentLanguage    @default(en)
  meetingType           MeetingType      @default(phone_call)
  durationMinutes       Int              @default(30)
  locationText          String?
  calendarProvider      CalendarProvider @default(manual)
  calendarUrl           String?
  followupAllowedWindows String[]        @default([])
  maxFollowups          Int              @default(2)
  leadFieldsRequired    Json
  disqualifyRules       Json
  complianceRules       Json
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BusinessProfile {
  id         String   @id @default(cuid())
  workspaceId String  @unique
  valueProp  String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Handoff {
  id          String        @id @default(cuid())
  workspaceId String
  leadId      String
  callId      String        @unique
  reason      HandoffReason
  status      HandoffStatus @default(requested)
  targetPhone String
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  call      Call      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

model MetricDaily {
  id               String   @id @default(cuid())
  workspaceId      String
  date             DateTime
  inboundCalls     Int      @default(0)
  qualifiedLeads   Int      @default(0)
  scheduledCalls   Int      @default(0)
  handoffs         Int      @default(0)
  closeRatePercent Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@index([workspaceId, date])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
